{
  "schema_version": 1,
  "engine": "p4-bounded-runtime-v4",
  "input": {
    "engine": "p4-input-v1"
  },
  "states": [
    "ready"
  ],
  "initial_state": "ready",
  "vars": {
    "status": {
      "type": "int",
      "init": 0
    },
    "key": {
      "type": "int",
      "init": 0
    },
    "savedDay": {
      "type": "int",
      "init": 0
    },
    "kind": {
      "type": "int",
      "init": 0
    },
    "day": {
      "type": "int",
      "init": 1
    },
    "cursor": {
      "type": "int",
      "init": 0
    }
  },
  "limits": {
    "day": [
      1,
      366
    ],
    "cursor": [
      0,
      3
    ],
    "key": [
      -1,
      3
    ],
    "status": [
      -3,
      1
    ],
    "kind": [
      0,
      12
    ],
    "savedDay": [
      0,
      366
    ]
  },
  "transitions": [
    {
      "from": "*",
      "on": "day.up",
      "inc": {
        "day": 1
      }
    },
    {
      "from": "*",
      "on": "slot.up",
      "inc": {
        "cursor": 1
      }
    },
    {
      "from": "*",
      "on": "first",
      "set": {
        "cursor": 0
      }
    }
  ],
  "dashboard": {
    "title": "Check-in log",
    "metricLabel": "Recorded day",
    "metricValue": {
      "var": "savedDay"
    },
    "badge": {
      "var": "kind"
    },
    "note": {
      "var": "key"
    },
    "visualStyle": "clean",
    "visualPalette": "mint",
    "visualLayout": "tool",
    "visualSprite": "star"
  },
  "surface": {
    "engine": "p4-app-surface-v1",
    "graphics": "p4-app-graphics-v1",
    "bindings": "p4-variable-bindings-v1",
    "background": 0,
    "elements": [
      {
        "type": "text",
        "x": 20,
        "y": 39,
        "w": 194,
        "h": 32,
        "color": 65535,
        "var_bind": "day",
        "font_size": 22
      },
      {
        "type": "text",
        "x": 222,
        "y": 39,
        "w": 194,
        "h": 32,
        "color": 65535,
        "var_bind": "cursor",
        "font_size": 22
      },
      {
        "type": "text",
        "x": 424,
        "y": 39,
        "w": 194,
        "h": 32,
        "color": 65535,
        "var_bind": "status",
        "font_size": 22
      },
      {
        "type": "text",
        "x": 20,
        "y": 91,
        "w": 194,
        "h": 32,
        "color": 65535,
        "var_bind": "savedDay",
        "font_size": 22
      },
      {
