  "records": {
    "version": 1,
    "words": 2,
    "user_slots": 4,
    "cache_slots": 1,
    "outputs": [
      "status",
      "key",
      "savedDay",
      "kind"
    ],
    "actions": {
      "work": {
        "inputs": [
          "day"
        ],
        "batch": [
          [
            "append",
            "user",
            "day",
            1
          ]
        ]
      },
      "rest": {
        "inputs": [
          "day"
        ],
        "batch": [
          [
            "append",
            "user",
            "day",
            2
          ]
        ]
      },
      "browse": {
        "inputs": [
          "cursor"
        ],
        "batch": [
          [
            "next",
            "user",
            "cursor"
          ]
        ]
      },
      "erase": {
        "inputs": [
          "cursor"
        ],
        "batch": [
          [
            "delete",
            "user",
            "cursor"
          ]
        ]
      }
    }
  },
  "tick": []
}
