{
  "schemaVersion": 1,
  "rules": [
    {"id":"ble-battery","deviceBoards":["wifi6"],"group":"hardware","when":{"/runtime/accessory":"battery-level"},"label":"读取蓝牙配件电量","paths":["device"],"requires":{"widgetBleAccessory":"p4-ble-read-v1"},"grant":"设备指定目标，实体 SW1 逐次允许"},
    {"id":"ble-temperature","deviceBoards":["wifi6"],"group":"hardware","when":{"/runtime/accessory":"ambient-temperature"},"label":"读取蓝牙配件温度","paths":["device"],"requires":{"widgetBleAccessory":"p4-ble-read-v1"},"grant":"设备指定目标，实体 SW1 逐次允许"},
    {"id":"mic-level","group":"hardware","when":{"/runtime/hardware/service":"microphone-level-v1"},"label":"前台麦克风电平","paths":["device"],"requires":{"widgetMicLevel":"microphone-level-v1"},"grant":"本机实体 SW1 逐次授权，退出停止"},
    {"id": "feed-mqtt-publish", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection/type": "mqtt-publish"}, "label": "由设备发布 MQTT 消息", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1", "widgetPrivateFeed": "p4-private-feed-v1", "widgetCredentialStorageReady": true, "widgetScopedWrite": "p4-scoped-write-v1"}, "grant": "设备绑定主题与值，逐次确认", "capsGroup": "feed"},
    {"id": "feed-https-submit", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection/type": "https-submit"}, "label": "由设备提交 HTTPS 写入", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1", "widgetPrivateFeed": "p4-private-feed-v1", "widgetCredentialStorageReady": true, "widgetScopedWrite": "p4-scoped-write-v1"}, "grant": "设备绑定目标与值，逐次确认", "capsGroup": "feed"},
    {"id": "feed-bearer", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection/type": "bearer"}, "label": "私人 HTTPS 列表", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1", "widgetPrivateFeed": "p4-private-feed-v1", "widgetCredentialStorageReady": true}, "grant": "设备服务账号", "capsGroup": "feed"},
    {"id": "feed-mqtt", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection/type": "mqtt"}, "label": "私人 MQTT TLS 订阅", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1", "widgetPrivateFeed": "p4-private-feed-v1", "widgetCredentialStorageReady": true}, "grant": "设备服务账号", "capsGroup": "feed"},
    {"id": "feed-mqtt-public", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection/type": "mqtt-public"}, "label": "公开 MQTT TLS 订阅", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1", "widgetPublicMqtt": "p4-public-mqtt-v1"}, "capsGroup": "feed"},
    {"id": "feed-https", "group": "data", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/connection": null}, "label": "公开 HTTPS 列表", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1"}, "capsGroup": "feed"},
    {"id": "stocks", "group": "data", "when": {"/runtime/data/source": "stocks.watchlist"}, "label": "刷新自选股报价", "paths": ["device-wifi", "pc-usb", "paired-pc-wifi"], "requires": {"widgetWifiData": "p4-wifi-data-v1"}, "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "watchlist", "group": "watchlist", "when": {"/runtime/data/source": "stocks.watchlist"}, "label": "编辑自选股列表", "paths": ["pc"]},
    {"id": "computer.status", "group": "data", "when": {"/runtime/data/source": "computer.status"}, "label": "读取电脑状态", "paths": ["pc-usb", "paired-pc-wifi"], "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "todos.upcoming", "group": "data", "when": {"/runtime/data/source": "todos.upcoming"}, "label": "读取电脑待办", "paths": ["pc-usb", "paired-pc-wifi"], "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "location.current", "group": "data", "when": {"/runtime/data/source": "location.current"}, "label": "读取共享位置", "paths": ["pc-usb", "paired-pc-wifi"], "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "github.me", "group": "data", "when": {"/runtime/data/source": "github.me"}, "label": "读取 GitHub 账号", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "本机已有账号授权", "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "fetch", "group": "data", "when": {"/fetchRows": true}, "label": "PC Fetch 数据列表", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "PC 启用与域名授权", "pcRequires": {"widgetData": "p4-data-list-v1"}},
    {"id": "provider", "group": "data", "when": {"/runtime/data/source": "*"}, "label": "数据提供器未确认", "paths": ["unknown"]},
    {"id": "headlines", "group": "news", "when": {"/runtime/vars/petui.wifi_data/init": "news.hn", "/runtime/host": true, "/runtime/vars/petui.wifi_data/type": "string"}, "label": "Hacker News 标题", "paths": ["device-wifi"], "requires": {"widgetWifiData": "p4-wifi-data-v1"}},
    {"id": "feed-refresh", "group": "refresh", "when": {"/runtime/data/source": "wifi.feed", "/runtime/data/refresh_action": "data.refresh"}, "label": "手动刷新设备列表", "paths": ["device-wifi"], "requires": {"widgetWifiFeed": "p4-wifi-feed-v1"}},
    {"id": "refresh-computer.status", "group": "refresh", "when": {"/runtime/data/source": "computer.status", "/runtime/data/refresh_action": "data.refresh"}, "label": "设备请求 PC 刷新", "paths": ["pc-usb"]},
    {"id": "refresh-todos.upcoming", "group": "refresh", "when": {"/runtime/data/source": "todos.upcoming", "/runtime/data/refresh_action": "data.refresh"}, "label": "设备请求 PC 刷新", "paths": ["pc-usb"]},
    {"id": "refresh-fetch", "group": "refresh", "when": {"/fetchRows": true, "/runtime/data/refresh_action": "data.refresh"}, "label": "设备请求 PC Fetch 刷新", "paths": ["pc-usb"]},
    {"id": "refresh-unknown", "group": "refresh", "when": {"/runtime/data/refresh_action": "data.refresh"}, "label": "手动刷新提供器待确认", "paths": ["unknown"]},
    {"id": "wifi-audio", "group": "media", "when": {"/runtime/media/source": "wifi.audio"}, "label": "播放设备网络音频", "paths": ["device-wifi"], "requires": {"widgetWifiAudio": "p4-wifi-audio-v1"}},
    {"id": "radio", "group": "media", "when": {"/id": "city-radio", "/runtime/media/source": "pc.city-radio"}, "label": "收听城市电台", "paths": ["device-wifi", "pc-usb"], "requires": {"widgetWifiAudio": "p4-wifi-audio-v1"}},
    {"id": "media", "group": "media", "when": {"/runtime/media/source": "*"}, "label": "电脑媒体播放", "paths": ["pc-usb"]},
    {"id": "stats", "group": "stats", "when": {"/id": "token-usage"}, "label": "读取 Agent 用量", "paths": ["pc-usb"]},
    {"id": "python-none", "group": "app", "when": {"/pythonInput": "none"}, "label": "Python 计算", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "PC 启用插件", "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "python-text-file", "group": "app", "when": {"/pythonInput": "text-file"}, "label": "Python 处理本地文件", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "PC 启用插件并选择文件", "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "python-https-json", "group": "app", "when": {"/pythonInput": "https-json"}, "label": "Python 处理 HTTPS 数据", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "PC 启用插件并授权域名", "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "fetch-host", "group": "app", "when": {"/app/engine": "pc-fetch-v1"}, "label": "PC Fetch 应用快照", "paths": ["pc-usb", "paired-pc-wifi"], "grant": "PC 启用与域名授权", "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "app", "group": "app", "when": {"/app/engine": "*"}, "label": "桌面应用数据与操作", "paths": ["pc-usb", "paired-pc-wifi"], "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "host", "group": "app", "when": {"/runtime/host": true}, "label": "桌面应用快照", "paths": ["pc-usb", "paired-pc-wifi"], "pcRequires": {"widgetAppHost": "p4-app-host-v1"}},
    {"id": "extension", "group": "extension", "when": {"/extension": true}, "label": "电脑扩展操作", "paths": ["pc"]},
    {"id": "local-tool", "group": "local", "when": {"/runtime/local/engine": "*"}, "label": "设备本地工具", "paths": ["device"], "requires": {"widgetLocalTools": "p4-local-tools-v1"}},
    {"id": "game", "group": "local", "when": {"/runtime/game/type": "*"}, "label": "设备本地游戏", "paths": ["device"]},
    {"id":"offline-reader","group":"local","when":{"/runtime/offlineReading":"embedded-shelf-v1","/runtime/hachiWasm":"*","/runtime/hachiCanvas":"640x480-v1"},"label":"离线阅读与本机书签","paths":["device"],"requires":{"widgetWasm":"hachi-wasm-v1"},"capsGroup":"wasm"},
    {"id": "wasm", "group": "local", "when": {"/runtime/hachiWasm": "*"}, "label": "设备 WASM 程序", "paths": ["device"], "requires": {"widgetWasm": "hachi-wasm-v1"}, "capsGroup": "wasm"},
    {"id": "clock", "group": "clock", "when": {"/runtime/local/kind": "countdown"}, "label": "冷启动后校时", "paths": ["device-wifi", "pc-usb"], "requires": {"wifiStatus": true}},
    {"id": "background-alarm", "group": "alarm", "when": {"/backgroundAlarm": true}, "label": "隐藏提醒", "paths": ["device"], "requires": {"widgetEvents": "p4-events-v1"}, "grant": "按本板实际提醒策略授权"},
    {"id": "alarm-consent", "group": "alarm-consent", "when": {"/backgroundAlarm": true}, "label": "在设备管理隐藏提醒授权", "paths": ["device"], "requires": {"widgetEvents": "p4-events-v1", "widgetLocalAlarms": "p4-local-alarms-v1"}, "grant": "本机按组件授权"},
    {"id": "program-resume-v1", "group": "resume", "when": {"/runtime/program/engine": "p4-component-program-v1", "/runtime/program/background": true, "/runtime/program/timers/0": "*"}, "label": "授权恢复组件定时程序", "paths": ["device"], "requires": {"widgetProgram": "p4-component-program-v1", "widgetLocalProgramResume": "p4-local-program-v1"}, "grant": "本机独立授权，冷启动等待有效 UTC"},
    {"id": "program-resume-v2", "group": "resume", "when": {"/runtime/program/engine": "p4-component-program-v2", "/runtime/program/background": true, "/runtime/program/timers/0": "*"}, "label": "授权恢复组件定时程序", "paths": ["device"], "requires": {"widgetProgram": "p4-component-program-v2", "widgetLocalProgramResume": "p4-local-program-v1"}, "grant": "本机独立授权，冷启动等待有效 UTC"},
    {"id": "program-v1", "group": "program", "when": {"/runtime/program/engine": "p4-component-program-v1"}, "label": "设备本地程序与私有状态", "paths": ["device"], "requires": {"widgetProgram": "p4-component-program-v1"}},
    {"id": "program-v2", "group": "program", "when": {"/runtime/program/engine": "p4-component-program-v2"}, "label": "设备本地程序与私有状态", "paths": ["device"], "requires": {"widgetProgram": "p4-component-program-v2"}},
    {"id": "save", "group": "save", "when": {"/runtime/persist/version": "*"}, "label": "保存和恢复组件状态", "paths": ["device"], "requires": {"widgetState": "p4-app-state-v1"}},
    {"id":"optional-narration","group":"speech","when":{"/app/autoRead":true},"label":"可选朗读（电脑需配置 TTS）","paths":["pc"],"optional":true},
    {"id": "local", "group": "fallback", "when": {}, "label": "设备本地运行", "paths": ["device"]}
  ],
  "capabilities": [
    {"when": "/runtime/data/response_map", "requires": {"widgetWifiFeedMap": "p4-wifi-feed-map-v1"}, "group": "feed"},
    {"when": "/runtime/data/http", "requires": {"widgetWifiFeedHttp": "p4-wifi-feed-http-v1"}, "group": "feed"},
    {"when": "/runtime/hachiNetwork", "requires": {"widgetWasmNetwork": "component-network-v1"}, "group": "wasm"},
    {"when": "/runtime/hachiNetwork/credentials", "requires": {"widgetComponentCredentials": "component-credentials-secure-v1"}, "group": "wasm"},
    {"when": "/runtime/hachiAudio", "requires": {"widgetWasmAudio": "hachi-audio-v2"}, "group": "wasm"},
    {"when": "/runtime/hachiCanvas", "requires": {"widgetWasmCanvas": "640x480-v1"}, "group": "wasm"},
    {"when": "/runtime/hachiHost", "requires": {"widgetWasmHost": "hachi-host-v1"}, "group": "wasm"}
  ]
}
